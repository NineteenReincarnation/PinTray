<Window x:Class="PinTray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinTray 设置"
        Width="480" Height="360"
        MinWidth="440" MinHeight="335"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="PinTray" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="保持窗口置顶，安静地留在系统托盘。"
                       FontSize="13" Opacity="0.74" Margin="0,4,0,0"/>
        </StackPanel>

        <Separator Grid.Row="2"/>

        <StackPanel Grid.Row="4">
            <CheckBox x:Name="StartupCheckBox" Content="随 Windows 登录自动启动"
                      FontSize="14" Margin="0,0,0,8"
                      Checked="OnStartupChanged" Unchecked="OnStartupChanged"/>
            <TextBlock Text="程序启动时仅显示在系统托盘，不打开主窗口。"
                       Opacity="0.68" FontSize="12" Margin="24,0,0,17"/>

            <TextBlock Text="切换当前窗口置顶的快捷键" FontSize="14"
                       Margin="0,0,0,8"/>
            <ComboBox x:Name="HotkeyComboBox" Height="34" Width="215"
                      HorizontalAlignment="Left" SelectionChanged="OnHotkeyChanged">
                <ComboBoxItem Content="Ctrl+Alt+P"/>
                <ComboBoxItem Content="Ctrl+Alt+T"/>
                <ComboBoxItem Content="Ctrl+Shift+Space"/>
                <ComboBoxItem Content="Win+Ctrl+T"/>
            </ComboBox>
            <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.75"
                       Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="VersionText" Grid.Column="0" VerticalAlignment="Center"
                       Opacity="0.65" FontSize="12"/>
            <Button Grid.Column="1" Width="95" Height="34"
                    Content="关闭" Click="OnCloseClicked"/>
        </Grid>
    </Grid>
</Window>
